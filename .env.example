# ============================================================
# PlantLife365 local-development configuration
# ============================================================

# Django
DJANGO_SECRET_KEY=change-me-before-real-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Email
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost

# Optional serial / ESP32 camera configuration
PLANTLIFE365_SERIAL_PORT=/dev/ttyCH341USB0
PLANTLIFE365_ESP_IP=192.168.4.1

# Optional local AI assistant
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=phi3

# Historical reference-dataset demo.
# Leave empty. The maintained feature remains disabled until Batch 5.
PLANTLIFE365_REFERENCE_DATASET=

# Maximum accepted JPEG size for ESP32 telemetry uploads
PLANTLIFE365_MAX_IMAGE_BYTES=2000000

# ============================================================
# Exploratory ML analytics
# ============================================================

PLANTLIFE365_ML_MAX_FILE_BYTES=5000000
PLANTLIFE365_ML_MAX_ROWS=50000
PLANTLIFE365_ML_MAX_COLUMNS=100

# ============================================================
# Local AI assistant
# ============================================================

OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=phi3
OLLAMA_TIMEOUT_SECONDS=20

# Keep false unless a deliberately configured remote endpoint
# is required and secured appropriately.
PLANTLIFE365_ALLOW_REMOTE_OLLAMA=false
